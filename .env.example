# Copiá este archivo a .env y completá tus valores. NUNCA subas .env a git.

# --- Credenciales de Binance ---
# Para testnet: generalas en https://testnet.binance.vision/
# Para mainnet: generalas en tu cuenta real de Binance (con restricción de IP recomendada)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Modo de operación (defaults seguros, NO tocar hasta validar) ---
USE_TESTNET=true
DRY_RUN=true

# --- Universo y timeframe ---
# Las 5 principales por market cap (excluyendo stablecoins)
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT
TIMEFRAME=1h
LOOKBACK_CANDLES=1000

# --- Capital y riesgo ---
TOTAL_CAPITAL_USDT=100
RISK_PER_TRADE_PCT=0.01
MAX_POSITION_PCT_PER_SYMBOL=0.20
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
MAX_DAILY_LOSS_PCT=0.05
MAX_DRAWDOWN_PCT=0.15

# --- Pesos del ensemble (deben sumar 1.0) ---
WEIGHT_TREND=0.35
WEIGHT_MEAN_REVERSION=0.25
WEIGHT_ML=0.40
ENTRY_THRESHOLD=0.35

# --- ML ---
ML_PREDICTION_HORIZON=3
ML_MIN_TRAIN_ROWS=300

LOG_LEVEL=INFO
LOG_FILE=trading_bot.log
